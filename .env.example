# Node 24.14+; all values stay on the server. No VITE_ secrets.
PUPIL_PORT=4318
PUPIL_WEB_PORT=5173
# Default Windows data folder: %LOCALAPPDATA%/PerfectPupil
# PUPIL_DATA_DIR=C:/Users/you/AppData/Local/PerfectPupil
# Optional alternative to saving a cloud key with Windows DPAPI:
# PUPIL_CLOUD_API_KEY=
